# Visara environment example — copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets or key files.
#
# The deploy script (scripts/deploy-play.mjs) auto-loads `.env` from the repo
# root via Node's native process.loadEnvFile(). Command-line flags override
# these values.

# =====================================================================
# Google Play upload  (consumed by scripts/deploy-play.mjs)
# =====================================================================

# Path to the Google Play service-account JSON key, OR the raw JSON itself.
# See DEPLOY.md -> "One-time Play Console + GCP setup" for how to create it.
# The key file is gitignored (service-account*.json); keep it out of git.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./service-account.json

# Optional defaults for the deploy script (flags still override these):
PLAY_TRACK=internal
# PLAY_STATUS=completed        # completed | draft | inProgress | halted
# PLAY_ROLLOUT=0.1             # userFraction for a staged (inProgress) rollout, 0 < f < 1
# PLAY_PACKAGE=com.visara.app
# PLAY_UPLOAD_TIMEOUT_MS=900000

# =====================================================================
# Android release signing  (consumed by GRADLE, not by the deploy script)
# =====================================================================
# These four gate the RELEASE signingConfig in android/app/build.gradle.
# Gradle does NOT read them from this .env — put them in
# `android/gradle.properties` (gitignored) or pass them with -P on the
# gradle command line. They are listed here only for documentation.
#
#   android/gradle.properties:
#     VISARA_UPLOAD_STORE_FILE=visara-upload.keystore
#     VISARA_UPLOAD_STORE_PASSWORD=...
#     VISARA_UPLOAD_KEY_ALIAS=visara-upload
#     VISARA_UPLOAD_KEY_PASSWORD=...
VISARA_UPLOAD_STORE_FILE=visara-upload.keystore
VISARA_UPLOAD_STORE_PASSWORD=changeme
VISARA_UPLOAD_KEY_ALIAS=visara-upload
VISARA_UPLOAD_KEY_PASSWORD=changeme

# =====================================================================
# App Store Connect upload  (consumed by scripts/deploy-appstore.sh)
# =====================================================================
# One-time: App Store Connect -> Users and Access -> Integrations ->
# App Store Connect API -> Team Keys -> Generate API Key (role: App Manager).
# Download the AuthKey_<KEYID>.p8 (downloadable ONCE), note the Key ID and
# the Issuer ID shown at the top of that page. See RELEASING.md.
# ASC_KEY_ID=ABC123DEFG
# ASC_ISSUER_ID=12345678-1234-1234-1234-123456789012
# ASC_API_KEY_PATH=./AuthKey_ABC123DEFG.p8
