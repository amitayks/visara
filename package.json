{
	"name": "visara",
	"version": "3.0.0",
	"private": true,
	"scripts": {
		"android": "react-native run-android",
		"ios": "react-native run-ios",
		"start": "react-native start",
		"apk": "cd android && ./gradlew assembleRelease",
		"aab": "npx react-native build-android --mode=release",
		"deploy:play": "node scripts/deploy-play.mjs",
		"deploy:play:build": "node scripts/deploy-play.mjs --build",
		"deploy:play:production": "node scripts/deploy-play.mjs --track production --status draft",
		"ca": "cd android && ./gradlew clean",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"bump": "node bump-version.js"
	},
	"dependencies": {
		"@bam.tech/react-native-image-resizer": "^3.0.11",
		"@dr.pogodin/react-native-fs": "^2.39.1",
		"@kesha-antonov/react-native-background-downloader": "^4.5.6",
		"@notifee/react-native": "^9.1.8",
		"@nozbe/simdjson": "^3.9.4",
		"@nozbe/watermelondb": "^0.28.0",
		"@react-native-camera-roll/camera-roll": "^7.10.2",
		"@react-navigation/bottom-tabs": "^7.18.6",
		"@react-navigation/native": "^7.3.6",
		"@react-navigation/stack": "^7.10.8",
		"@shopify/flash-list": "^2.3.2",
		"babel-plugin-module-resolver": "^5.0.2",
		"expo": "~57.0.2",
		"expo-image": "~57.0.0",
		"minisearch": "^7.2.0",
		"react": "19.2.3",
		"react-native": "0.86.0",
		"react-native-background-actions": "^4.1.0",
		"react-native-device-info": "^15.0.2",
		"react-native-executorch": "0.9.2",
		"react-native-executorch-bare-resource-fetcher": "^0.9.1",
		"react-native-gesture-handler": "^3.0.2",
		"react-native-keychain": "^10.0.0",
		"react-native-mmkv": "4.3.2",
		"react-native-nitro-modules": "0.36.1",
		"react-native-pager-view": "^8.0.2",
		"react-native-paper": "^5.14.5",
		"react-native-quick-base64": "^3.0.0",
		"react-native-quick-crypto": "1.1.5",
		"react-native-reanimated": "4.5.1",
		"react-native-reanimated-dnd": "2.0.0",
		"react-native-safe-area-context": "^5.8.0",
		"react-native-screens": "^4.25.2",
		"react-native-vector-icons": "^10.3.0",
		"react-native-worklets": "0.10.1"
	},
	"codegenConfig": {
		"name": "VisaraSpecs",
		"type": "modules",
		"jsSrcsDir": "src/native-modules",
		"android": {
			"javaPackageName": "com.visara.specs"
		}
	},
	"engines": {
		"node": ">= 22.11.0",
		"npm": ">=9"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-proposal-decorators": "^7.29.0",
		"@babel/preset-env": "^7.29.0",
		"@babel/runtime": "^7.29.0",
		"@biomejs/biome": "^2.2.5",
		"@react-native-community/cli": "20.1.0",
		"@react-native-community/cli-platform-android": "20.1.0",
		"@react-native-community/cli-platform-ios": "20.1.0",
		"@react-native/babel-preset": "0.86.0",
		"@react-native/jest-preset": "0.86.0",
		"@react-native/metro-config": "0.86.0",
		"@testing-library/react-native": "^14.0.1",
		"@types/react": "^19.2.1",
		"google-auth-library": "^10.9.0",
		"jest": "^29.6.3",
		"test-renderer": "^1.2.0",
		"typescript": "^5.9.3"
	}
}
