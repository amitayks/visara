# Expo modules autolinking (expo-image / expo-modules-core)
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

project 'Visara.xcodeproj'
platform :ios, '26.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# react-native-image-resizer 3.0.11 (latest) hand-declares RN-0.71-era New-Arch
# pod deps (RCT-Folly, React-Codegen, RCTRequired, RCTTypeSafety) that RN 0.86
# no longer vends as standalone specs; install_modules_dependencies(s) in the
# same podspec already injects the correct per-version set. Strip the stale
# manual lines before resolution. Idempotent; re-applied after every npm install.
resizer_podspec = File.join(__dir__, '..', 'node_modules', '@bam.tech',
  'react-native-image-resizer', 'react-native-image-resizer.podspec')
if File.exist?(resizer_podspec)
  contents = File.read(resizer_podspec)
  stripped = contents.gsub(/^\s*s\.dependency "(RCT-Folly|React-Codegen|RCTRequired|RCTTypeSafety)"\n/, '')
  if stripped != contents
    File.write(resizer_podspec, stripped)
    Pod::UI.puts "[Visara] Stripped stale New-Arch deps from react-native-image-resizer.podspec".green
  end
end

target 'Visara' do
  use_expo_modules!

  config_command = [
    'node',
    '--no-warnings',
    '--eval',
    'require(\'expo/bin/autolinking\')',
    'expo-modules-autolinking',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ]

  config = use_native_modules!(config_command)

  # WatermelonDB dependencies
  pod 'simdjson', :path => '../node_modules/@nozbe/simdjson'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # Enabling the New Architecture for React Native
    :fabric_enabled => true,
    :hermes_enabled => true
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # The expo integration injects -fmodule-map-file for ReactCodegen into the
    # app target's OTHER_CFLAGS. That forces clang to build ReactCodegen as a
    # module whenever our app-level TurboModule .mm files include the generated
    # VisaraSpecs headers — and the module build compiles the C++ spec headers
    # in ObjC context ("'utility' file not found"). Nothing in the app imports
    # ReactCodegen as a module (Swift never touches it), so strip the flag and
    # let the headers compile textually in our ObjC++ TUs. Idempotent.
    Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-Visara', 'Pods-Visara.*.xcconfig')).each do |xcconfig|
      contents = File.read(xcconfig)
      stripped = contents.gsub(/(?:-Xcc\s+)?-fmodule-map-file="\$\{PODS_ROOT\}\/Headers\/Public\/ReactCodegen\/ReactCodegen\.modulemap"\s*/, '')
      if stripped != contents
        File.write(xcconfig, stripped)
        Pod::UI.puts "[Visara] Stripped ReactCodegen module-map flag from #{File.basename(xcconfig)}".green
      end
    end

    # react-native-executorch's pod injects SDK-conditional OTHER_LDFLAGS lines
    # (its .xcframework path) into the Pods-Visara aggregate xcconfigs. An
    # xcconfig conditional REPLACES the unconditional line for that SDK, which
    # silently drops CocoaPods' `-ObjC` (and every -l flag) from simulator and
    # device links. Most pods survive via ld auto-linking + explicit codegen
    # references, but legacy RCT_EXPORT_MODULE-only classes (e.g. Unistyles'
    # UnistylesModule, retained solely through +load) get dead-stripped and
    # their Nitro hybrids never register. Re-append the full unconditional
    # flag set to every conditional line. Idempotent.
    Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-Visara', 'Pods-Visara.*.xcconfig')).each do |xcconfig|
      lines = File.readlines(xcconfig)
      base = lines.find { |l| l.start_with?('OTHER_LDFLAGS = ') }
      next unless base
      base_flags = base.sub('OTHER_LDFLAGS = ', '').sub('$(inherited)', '').strip
      changed = false
      lines = lines.map do |line|
        if line =~ /^OTHER_LDFLAGS\[sdk=[^\]]+\] = / && !line.include?('-ObjC')
          changed = true
          "#{line.rstrip} #{base_flags}\n"
        else
          line
        end
      end
      if changed
        File.write(xcconfig, lines.join)
        Pod::UI.puts "[Visara] Re-appended -ObjC/libs to SDK-conditional OTHER_LDFLAGS in #{File.basename(xcconfig)}".green
      end
    end

    # fmt 11.0.2 ships a consteval compile-time format-string check that
    # miscompiles on Xcode 16.3+ AppleClang ("call to consteval function ...
    # is not a constant expression" in format-inl.h). Force-disable consteval
    # in fmt's base.h so it uses the supported constexpr check path instead.
    # base.h defines FMT_USE_CONSTEVAL unconditionally, so a -D override is
    # ignored — we must patch the header. Idempotent; re-applied every install.
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      unless contents.include?('#undef FMT_USE_CONSTEVAL')
        contents = contents.sub(
          "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval",
          "#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
        )
        File.write(fmt_base, contents)
        Pod::UI.puts "[Visara] Patched fmt/base.h to disable consteval (Xcode 16.3+ fix)".green
      end
    end
  end
end
