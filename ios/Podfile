# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

project 'Visara.xcodeproj'
platform :ios, '26.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Visara' do
  config = use_native_modules!

  # WatermelonDB dependencies
  pod 'simdjson', :path => '../node_modules/@nozbe/simdjson'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # Enabling the New Architecture for React Native
    :fabric_enabled => true,
    :hermes_enabled => true
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt 11.0.2 ships a consteval compile-time format-string check that
    # miscompiles on Xcode 16.3+ AppleClang ("call to consteval function ...
    # is not a constant expression" in format-inl.h). Force-disable consteval
    # in fmt's base.h so it uses the supported constexpr check path instead.
    # base.h defines FMT_USE_CONSTEVAL unconditionally, so a -D override is
    # ignored — we must patch the header. Idempotent; re-applied every install.
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      unless contents.include?('#undef FMT_USE_CONSTEVAL')
        contents = contents.sub(
          "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval",
          "#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
        )
        File.write(fmt_base, contents)
        Pod::UI.puts "[Visara] Patched fmt/base.h to disable consteval (Xcode 16.3+ fix)".green
      end
    end
  end
end
