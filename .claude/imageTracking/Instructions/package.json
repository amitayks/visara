{
  "dependencies": {
    // Core React Native
    "react": "18.2.0",
    "react-native": "0.72.0",
    // Navigation
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "react-native-screens": "^3.22.1",
    "react-native-safe-area-context": "^4.7.1",
    "react-native-gesture-handler": "^2.12.1",
    // UI Components
    "@shopify/flash-list": "^1.5.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-reanimated": "^3.4.2",
    // Storage & Database
    // "@react-native-async-storage/async-storage": "^1.19.1", // use mmkv insteed
    "@nozbe/watermelondb": "^0.27.1",
    "@nozbe/with-observables": "^1.6.0",
    // State Management
    "zustand": "^4.4.1",
    "rxjs": "^7.8.1",
    "@tanstack/react-query": "^4.32.6",
    // Permissions
    "react-native-permissions": "^3.9.0",
    // File System
    "react-native-fs": "^2.20.0",
    // Image Processing
    "@react-native-camera-roll/camera-roll": "^6.0.0",
    // OCR (existing)
    "@react-native-ml-kit/text-recognition": "^1.3.0",
    // Utilities
    "crypto-js": "^4.1.1",
    // Development
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^5.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/plugin-proposal-decorators": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/runtime": "^7.22.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "metro-react-native-babel-preset": "^0.77.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "clean": "cd android && ./gradlew clean && cd ../ios && xcodebuild clean && cd ..",
    "pod-install": "cd ios && pod install",
    "rebuild-android": "cd android && ./gradlew clean && cd .. && npx react-native run-android",
    "rebuild-ios": "cd ios && xcodebuild clean && pod install && cd .. && npx react-native run-ios"
  },
  "notes": {
    "installation": [
      "1. Install all dependencies: npm install or yarn install",
      "2. Install iOS pods: cd ios && pod install",
      "3. Link native dependencies (if needed): npx react-native link",
      "4. Add native module files to iOS and Android projects",
      "5. Update MainApplication.java for Android",
      "6. Update Info.plist for iOS permissions",
      "7. Clean and rebuild both platforms"
    ],
    "removed_packages": [
      "Complex background service packages",
      "react-native-background-fetch",
      "react-native-background-task",
      "Complex scanning libraries",
      "Unnecessary UI libraries"
    ],
    "native_modules": {
      "GalleryObserver": {
        "ios": "Manual addition to Xcode project",
        "android": "Added via MainApplication.java"
      }
    }
  }
}